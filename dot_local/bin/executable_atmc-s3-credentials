#!/usr/bin/env bash
# Credential helper for the `atmc` AWS profile (see ~/.aws/config).
#
# Prints the Ceph S3 key as JSON on stdout, in the format `credential_process`
# expects. The key is read from atomic-bench's DVC remote config, which is
# where it already lives -- so there is no second copy in ~/.aws/credentials
# and nothing secret in the chezmoi repo.
#
# Point ATMC_DVC_CONFIG at the file if the checkout is not in ~/Projects.
set -euo pipefail

CONFIG="${ATMC_DVC_CONFIG:-$HOME/Projects/atomic-bench/.dvc/config}"

if [[ ! -r "$CONFIG" ]]; then
  echo "atmc-s3-credentials: cannot read $CONFIG" >&2
  echo "  set ATMC_DVC_CONFIG to atomic-bench's .dvc/config" >&2
  exit 1
fi

if ! command -v python3 >/dev/null 2>&1; then
  echo "atmc-s3-credentials: python3 not on PATH" >&2
  exit 1
fi

exec python3 - "$CONFIG" <<'PY'
import configparser, json, sys

path = sys.argv[1]
cfg = configparser.ConfigParser()
cfg.read(path)

# Any remote section carrying a key will do; atomic-bench calls its remote
# "nfs", but don't hard-code that in case it is renamed. DVC writes the header
# as ['remote "nfs"'] -- quotes included -- so configparser hands back the
# section name with them attached; strip before matching.
def is_remote(name):
    return name.strip().strip("'\"").startswith("remote ")

section = next(
    (s for s in cfg.sections()
     if is_remote(s) and cfg.has_option(s, "access_key_id")),
    None,
)
if section is None:
    sys.exit(f"atmc-s3-credentials: no remote with credentials in {path}")

print(json.dumps({
    "Version": 1,
    "AccessKeyId": cfg.get(section, "access_key_id"),
    "SecretAccessKey": cfg.get(section, "secret_access_key"),
}))
PY
